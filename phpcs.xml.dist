<?xml version="1.0" encoding="UTF-8"?>
<ruleset name="VideoTrack Moodle Extra">
    <description>Canonical PHPCS release gate for mod_videotrack.</description>

    <arg name="extensions" value="php"/>

    <rule ref="moodle-extra">
        <!--
            Remaining baseline debt after the 1.7.84 language-pack cleanup.
            Keep this exclusion exact: all other moodle-extra warnings/errors
            remain release-blocking. Revisit it with the PHPUnit coverage-metadata migration.
        -->
        <exclude name="moodle.PHPUnit.TestCaseCovers.Missing"/>
    </rule>
</ruleset>
